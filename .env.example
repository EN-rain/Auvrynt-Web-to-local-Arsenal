HOST=127.0.0.1
PORT=7676
# Owner password generated by `auvrynt init` in ~/.auvrynt/auth.json. Set this
# only for non-interactive or fully env-driven deployments.
# AUVRYNT_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# AUVRYNT_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# AUVRYNT_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUVRYNT_OAUTH_SCOPES=auvrynt
# AUVRYNT_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
AUVRYNT_ALLOWED_ROOTS=/home/user/personal,/home/user/work
# For temporary tunnels, prefer setting this per run. Auvrynt derives the
# inbound Host allowlist from this URL.
# AUVRYNT_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# AUVRYNT_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
AUVRYNT_TOOL_MODE=full
AUVRYNT_TOOL_NAMING=legacy
# off | changes | full. Defaults to changes.
# changes creates one aggregate review widget via review_changes instead of per-tool iframes.
AUVRYNT_WIDGETS=changes
AUVRYNT_LOG_LEVEL=info
AUVRYNT_LOG_FORMAT=json
AUVRYNT_LOG_REQUESTS=1
AUVRYNT_LOG_ASSETS=0
AUVRYNT_LOG_TOOL_CALLS=1
AUVRYNT_LOG_SHELL_COMMANDS=0
# AUVRYNT_TRUST_PROXY=1
# AUVRYNT_STATE_DIR=/home/user/.local/share/auvrynt
# AUVRYNT_WORKTREE_ROOT=/home/user/.auvrynt/worktrees
# AUVRYNT_AUTO_LOAD_AGENTS_MD=1
# Skills are enabled by default. Set AUVRYNT_SKILLS=0 to hide them.
# AUVRYNT_SKILLS=0
# AUVRYNT_AGENT_DIR=/home/user/.codex
# AUVRYNT_SKILL_PATHS=/home/user/.codex/skills,/home/user/.claude/skills
